{
  "name": "patrick-laing",
  "version": "1.0.0",
  "description": "The website of Patrick Laing.",
  "main": "index.js",
  "author": "Laura Brown <laura@laurabrown.xyz> (https://laurabrown.xyz)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/1aurabrown/patrick-laing-splash.git"
  },
  "scripts": {
    "start": "parcel",
    "build": "parcel build src/index.pug --public-url ./ -d dist"
  },
  "source": "src/index.pug",
  "parcel-namer-struct": [
    {
      "type": [
        "scss",
        "css"
      ],
      "dest": "/styles/"
    },
    {
      "type": [
        "js"
      ],
      "dest": "/scripts/"
    },
    {
      "type": [
        "jpeg",
        "jpg",
        "png"
      ],
      "dest": "/images/"
    }
  ],
  "devDependencies": {
    "@parcel/transformer-pug": "^2.13.3",
    "@parcel/transformer-sass": "^2.13.3",
    "autoprefixer": "^10.4.20",
    "parcel": "^2.13.3",
    "parcel-namer-struct": "^1.0.0",
    "postcss": "^8.1.0",
    "posthtml-beautify": "^0.7.0"
  },
  "dependencies": {
    "@vimeo/player": "^2.25.1",
    "jquery": "^3.4.1",
    "js-yaml": "^3.13.1"
  }
}
